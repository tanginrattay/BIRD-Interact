# BIRD-Interact-ADK Configuration
# Copy this to .env and fill in your values

# ── LLM ──
# Set the API key for your LLM provider (used by LiteLlm)
# See https://docs.litellm.ai/docs/providers for supported providers
# ANTHROPIC_API_KEY=sk-ant-...      # for anthropic/claude-*
# OPENAI_API_KEY=sk-...             # for openai/gpt-*
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

# ── Models ──
# LiteLlm model format: provider/model-name
# Examples: anthropic/claude-sonnet-4-20250514, openai/gpt-4o, ollama_chat/llama3
SYSTEM_AGENT_MODEL=deepseek/deepseek-flash
# Official Flash ID (currently V4.1); non-thinking mode configured in shared/llm.py.
USER_SIM_MODEL=anthropic/claude-haiku-4-5-20251001

# Qwen simulator on Bailian (independent key; leave system-agent settings alone):
# USER_SIM_MODEL=qwen3.7-plus
# USER_SIM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# USER_SIM_API_KEY=
# USER_SIM_PIPELINE=single_stage
# USER_SIM_ENABLE_THINKING=false
# USER_SIM_THINKING_BUDGET=2048
# Pipeline options: auto (legacy defaults), single_stage, two_stage.

# ── Dataset ──
# Options: "lite" (300 tasks, 18 DBs) or "full" (600 tasks, 26 DBs)
DATASET=lite

# ── PostgreSQL ──
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=root
PG_PASSWORD=123123

# ── Service Ports ──
SYSTEM_AGENT_PORT=6000
USER_SIM_PORT=6001
DB_ENV_PORT=6002

# ── Budget / Turns ──
# a-interact: budget = 6 + 2*ambiguities + 2*patience (per task)
# c-interact: max_turns = ambiguities + patience (per task)
PATIENCE=3
